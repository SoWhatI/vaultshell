{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-09-29/server.schema.json",
  "name": "io.github.SoWhatI/vaultshell",
  "description": "MCP server that injects secrets into shell commands at exec time and guarantees plaintext never reaches the model context",
  "version": "0.1.0",
  "repository": {
    "url": "https://github.com/SoWhatI/vaultshell",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "npm",
      "identifier": "vaultshell",
      "version": "0.1.0",
      "transport": {
        "type": "stdio"
      }
    }
  ]
}

{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-09-29/server.schema.json",
  "name": "io.github.SoWhatI/vaultshell",
  "description": "Injects secrets into shell commands at exec time; plaintext never reaches the LLM context",
  "version": "0.1.2",
  "repository": {
    "url": "https://github.com/SoWhatI/vaultshell",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "oci",
      "identifier": "ghcr.io/sowhati/vaultshell:0.1.2",
      "transport": {
        "type": "stdio"
      }
    }
  ]
}
